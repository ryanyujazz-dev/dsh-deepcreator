{
  "name": "@ryanyujazz/dsh-client-ui-workspace",
  "description": "Workspace picker plugin: one WorkspacePicker registered into the sidebar and empty-state workspace slots",
  "version": "0.1.0",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ryanyujazz-dev/dsh-deepcreator.git",
    "directory": "packages/client/ui-workspace"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-api-remotes",
        "@ryanyujazz/dsh-client-locale",
        "@deepseek-ai/dsh-client-runtime",
        "@ryanyujazz/dsh-client-ui-conversation",
        "@ryanyujazz/dsh-client-ui-sidebar"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "bundle": "tsc -p tsconfig.json && tsdown",
    "watch": "tsdown --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "license": "MIT",
  "dependencies": {
    "clsx": "^2.0.0"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-api-remotes": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-client-connection": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-client-runtime": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-client-ui-slots": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-invariants": "^0.1.0-rc.6",
    "@deepseek-ai/cordis": "4.0.1",
    "react": "^18.2.0",
    "@ryanyujazz/dsh-client-locale": "^0.1.0",
    "@ryanyujazz/dsh-client-ui-primitives": "^0.1.0",
    "@deepseek-ai/dsh-typert-protocol": "^0.1.0-rc.6",
    "@ryanyujazz/dsh-session-admin": "^0.1.0"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-api-remotes": "0.1.0-rc.6",
    "@deepseek-ai/dsh-client-connection": "0.1.0-rc.6",
    "@deepseek-ai/dsh-client-runtime": "0.1.0-rc.6",
    "@deepseek-ai/dsh-client-test-runtime": "0.1.0-rc.6",
    "@deepseek-ai/dsh-client-ui-slots": "0.1.0-rc.6",
    "@deepseek-ai/dsh-client-web-react": "0.1.0-rc.6",
    "@deepseek-ai/dsh-invariants": "0.1.0-rc.6",
    "@types/react": "~18.3.1",
    "@deepseek-ai/cordis": "4.0.1",
    "react": "^18.2.0",
    "@ryanyujazz/dsh-client-locale": "workspace:^",
    "@ryanyujazz/dsh-client-ui-conversation": "workspace:^",
    "@ryanyujazz/dsh-client-ui-primitives": "workspace:^",
    "@ryanyujazz/dsh-client-ui-sidebar": "workspace:^",
    "@deepseek-ai/dsh-typert-protocol": "0.1.0-rc.6",
    "@ryanyujazz/dsh-session-admin": "workspace:^"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/client.js",
    "lib/types/**/*.d.ts"
  ]
}
