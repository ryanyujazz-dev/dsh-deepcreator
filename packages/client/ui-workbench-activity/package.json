{
  "name": "@ryanyujazz/dsh-client-ui-workbench-activity",
  "description": "DeepCreator Workbench Activity provider backed directly by Runtime jobsBySession",
  "version": "0.1.0",
  "publishConfig": { "access": "public" },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": { "types": "./lib/types/index.d.ts", "default": "./lib/index.js" },
    "./client": { "types": "./lib/types/client/index.d.ts", "default": "./lib/client.js" },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "dsh": { "client": { "inject": [
    "@ryanyujazz/dsh-client-locale",
    "@deepseek-ai/dsh-client-runtime",
    "@ryanyujazz/dsh-client-ui-workbench",
    "@ryanyujazz/dsh-client-ui-primitives"
  ], "platform": "web" } },
  "scripts": { "bundle": "tsc -p tsconfig.json && tsdown", "watch": "tsdown --watch", "typecheck": "tsc -p tsconfig.json --noEmit" },
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.1",
    "@deepseek-ai/dsh-client-runtime": "^0.1.0-rc.7",
    "@deepseek-ai/dsh-client-ui-slots": "^0.1.0-rc.7",
    "react": "^18.2.0",
    "@ryanyujazz/dsh-client-locale": "^0.1.0",
    "@ryanyujazz/dsh-client-ui-primitives": "^0.1.0",
    "@ryanyujazz/dsh-client-ui-workbench": "^0.1.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.1",
    "@deepseek-ai/dsh-client-runtime": "0.1.0-rc.7",
    "@deepseek-ai/dsh-client-ui-slots": "0.1.0-rc.7",
    "@types/react": "~18.3.1",
    "react": "^18.2.0",
    "@ryanyujazz/dsh-client-locale": "workspace:^",
    "@ryanyujazz/dsh-client-ui-primitives": "workspace:^",
    "@ryanyujazz/dsh-client-ui-workbench": "workspace:^"
  },
  "files": ["lib/index.js", "lib/client.js", "lib/types/**/*.d.ts"]
}
