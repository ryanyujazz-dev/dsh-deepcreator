{
  "name": "@ryanyujazz/dsh-client-ui-browser",
  "description": "DeepCreator Browser state client, native surface host, and Workbench Browser presenter",
  "version": "0.1.0",
  "publishConfig": { "access": "public" },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": { "types": "./lib/types/index.d.ts", "default": "./lib/index.js" },
    "./client": { "types": "./lib/types/client/index.d.ts", "default": "./lib/client.js" },
    "./package.json": "./package.json"
  },
  "dsh": { "client": { "inject": [
    "@deepseek-ai/dsh-client-runtime", "@deepseek-ai/dsh-client-connection", "@ryanyujazz/dsh-client-locale", "@ryanyujazz/dsh-client-workbench-remotes",
    "@ryanyujazz/dsh-client-ui-workbench", "@ryanyujazz/dsh-client-ui-primitives", "@ryanyujazz/dsh-client-ui-settings",
    "@ryanyujazz/dsh-client-presentation"
  ], "platform": "web" } },
  "scripts": { "bundle": "tsc -p tsconfig.json && tsdown", "watch": "tsdown --watch", "typecheck": "tsc -p tsconfig.json --noEmit", "test": "vitest run --root ../../.. packages/client/ui-browser/tests" },
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.1", "@deepseek-ai/dsh-client-runtime": "^0.1.1-rc.2", "@deepseek-ai/dsh-client-connection": "^0.1.1-rc.2", "@deepseek-ai/dsh-client-ui-slots": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-typert-protocol": "^0.1.1-rc.2", "@ryanyujazz/dsh-browser": "^0.1.0", "@ryanyujazz/dsh-client-locale": "^0.1.0",
    "@ryanyujazz/dsh-client-workbench-remotes": "^0.1.0", "@ryanyujazz/dsh-client-ui-workbench": "^0.1.0", "@ryanyujazz/dsh-client-ui-primitives": "^0.1.0", "@ryanyujazz/dsh-client-ui-settings": "^0.1.0", "react": "^18.2.0",
    "@ryanyujazz/dsh-client-presentation": "^0.1.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.1", "@deepseek-ai/dsh-client-runtime": "0.1.1-rc.2", "@deepseek-ai/dsh-client-connection": "0.1.1-rc.2", "@deepseek-ai/dsh-client-ui-slots": "0.1.1-rc.2",
    "@deepseek-ai/dsh-typert-protocol": "0.1.1-rc.2", "@ryanyujazz/dsh-browser": "workspace:^", "@ryanyujazz/dsh-client-locale": "workspace:^",
    "@ryanyujazz/dsh-client-workbench-remotes": "workspace:^", "@ryanyujazz/dsh-client-ui-workbench": "workspace:^", "@ryanyujazz/dsh-client-ui-primitives": "workspace:^", "@ryanyujazz/dsh-client-ui-settings": "workspace:^",
    "@ryanyujazz/dsh-client-presentation": "workspace:^",
    "@testing-library/react": "^16.1.0", "@types/react": "~18.3.1", "react": "^18.2.0", "react-dom": "^18.2.0", "typescript": "^6.0.3", "vitest": "^3.2.4"
  },
  "files": ["lib/index.js", "lib/client.js", "lib/types/**/*.d.ts", "README.md"]
}
