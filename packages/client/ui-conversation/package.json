{
  "name": "@ryanyujazz/dsh-client-ui-conversation",
  "description": "Conversation domain: skeleton, ordered chat flow, composer with the Host-backed busy-Enter preference, and details host",
  "version": "0.1.0",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ryanyujazz-dev/dsh-deepcreator.git",
    "directory": "packages/client/ui-conversation"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    }
  },
  "dsh": {
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@ryanyujazz/dsh-client-locale",
        "@deepseek-ai/dsh-client-runtime",
        "@ryanyujazz/dsh-client-ui-settings",
        "@deepseek-ai/dsh-api-remotes"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "bundle": "tsc -p tsconfig.json && tsdown",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "watch": "tsdown --watch"
  },
  "license": "MIT",
  "dependencies": {
    "@deepseek-ai/dsh-agent": "^0.1.2-rc.1",
    "@deepseek-ai/dsh-api-session-controller": "0.1.2-rc.1",
    "@deepseek-ai/dsh-api-workspace-controller": "0.1.2-rc.1",
    "@deepseek-ai/dsh-client-connection": "^0.1.2-rc.1",
    "@deepseek-ai/dsh-client-store": "0.1.2-rc.1",
    "@deepseek-ai/dsh-client-ui-conversation": "0.1.2-rc.1",
    "@deepseek-ai/dsh-client-ui-input-trigger": "^0.1.2-rc.1",
    "@deepseek-ai/dsh-client-ui-renderer": "0.1.2-rc.1",
    "@deepseek-ai/dsh-client-ui-settings": "0.1.2-rc.1",
    "@deepseek-ai/dsh-compaction": "^0.1.2-rc.1",
    "@deepseek-ai/dsh-session": "0.1.2-rc.1",
    "@deepseek-ai/dsh-session-projection": "0.1.2-rc.1",
    "@deepseek-ai/dsh-session-stats": "^0.1.2-rc.1",
    "@deepseek-ai/dsh-session-turn-outline": "^0.1.2-rc.1",
    "@deepseek-ai/dsh-settings": "^0.1.2-rc.1",
    "@deepseek-ai/dsh-tools": "^0.1.2-rc.1",
    "@deepseek-ai/dsh-util-workspace-path": "0.1.2-rc.1",
    "@deepseek-ai/schemastery": "3.18.2",
    "@lexical/history": "^0.49.0",
    "@lexical/plain-text": "^0.49.0",
    "@lexical/text": "^0.49.0",
    "@lexical/utils": "^0.49.0",
    "@ryanyujazz/dsh-client-compat": "workspace:*",
    "clsx": "^2.0.0",
    "lexical": "^0.49.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.2",
    "@deepseek-ai/dsh-client-ui-attachment": "^0.1.2-rc.1",
    "@deepseek-ai/dsh-client-ui-slots": "^0.1.2-rc.1",
    "react": "^18.2.0",
    "@ryanyujazz/dsh-client-ui-primitives": "^0.1.0",
    "@ryanyujazz/dsh-client-ui-workbench": "^0.1.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.2",
    "@deepseek-ai/dsh-api-remotes": "0.1.2-rc.1",
    "@deepseek-ai/dsh-api-session-controller": "0.1.2-rc.1",
    "@deepseek-ai/dsh-api-workspace-controller": "0.1.2-rc.1",
    "@deepseek-ai/dsh-attachment": "0.1.2-rc.1",
    "@deepseek-ai/dsh-brand": "0.1.2-rc.1",
    "@deepseek-ai/dsh-client-store": "0.1.2-rc.1",
    "@deepseek-ai/dsh-client-test-runtime": "0.1.2-rc.1",
    "@deepseek-ai/dsh-client-ui-attachment": "0.1.2-rc.1",
    "@deepseek-ai/dsh-client-ui-chat": "0.1.2-rc.1",
    "@deepseek-ai/dsh-client-ui-primitives": "0.1.2-rc.1",
    "@deepseek-ai/dsh-client-ui-renderer": "0.1.2-rc.1",
    "@deepseek-ai/dsh-client-ui-session": "0.1.2-rc.1",
    "@deepseek-ai/dsh-client-ui-slots": "0.1.2-rc.1",
    "@deepseek-ai/dsh-commands": "0.1.2-rc.1",
    "@deepseek-ai/dsh-goal": "0.1.2-rc.1",
    "@deepseek-ai/dsh-invariants": "0.1.2-rc.1",
    "@deepseek-ai/dsh-llm": "0.1.2-rc.1",
    "@deepseek-ai/dsh-llm-retry": "0.1.2-rc.1",
    "@deepseek-ai/dsh-permission-presets": "0.1.2-rc.1",
    "@deepseek-ai/dsh-plan-mode": "0.1.2-rc.1",
    "@deepseek-ai/dsh-session": "0.1.2-rc.1",
    "@deepseek-ai/dsh-token-meter": "0.1.2-rc.1",
    "@deepseek-ai/dsh-tool-todo": "0.1.2-rc.1",
    "@deepseek-ai/dsh-util-crypto": "0.1.2-rc.1",
    "@deepseek-ai/dsh-util-workspace-path": "0.1.2-rc.1",
    "@deepseek-ai/dsh-workspace": "0.1.2-rc.1",
    "@lexical/headless": "^0.49.0",
    "@ryanyujazz/dsh-client-locale": "workspace:^",
    "@ryanyujazz/dsh-client-ui-layout": "workspace:^",
    "@ryanyujazz/dsh-client-ui-primitives": "workspace:^",
    "@ryanyujazz/dsh-client-ui-settings": "workspace:^",
    "@ryanyujazz/dsh-client-ui-workbench": "workspace:^",
    "@ryanyujazz/dsh-client-ui-workspace": "workspace:^",
    "@types/react": "~18.3.1",
    "@types/react-dom": "~18.3.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "zod": "^4.4.3"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/client.js",
    "lib/types/**/*.d.ts"
  ]
}
