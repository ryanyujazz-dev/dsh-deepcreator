{
  "name": "@ryanyujazz/dsh-client-presentation",
  "description": "React-free DeepCreator presentation client runtime and presenter registry",
  "version": "0.1.0",
  "publishConfig": { "access": "public" },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": { "types": "./lib/types/index.d.ts", "default": "./lib/index.js" },
    "./client": { "types": "./lib/types/client/index.d.ts", "default": "./lib/client.js" },
    "./package.json": "./package.json"
  },
  "dsh": { "client": { "inject": ["@deepseek-ai/dsh-client-runtime", "@ryanyujazz/dsh-client-workbench-remotes"], "platform": "web" } },
  "scripts": {
    "bundle": "tsc -p tsconfig.json && tsdown", "watch": "tsdown --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit", "test": "vitest run --root ../../.. packages/client/presentation/tests"
  },
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.1", "@deepseek-ai/dsh-client-runtime": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-typert-protocol": "^0.1.1-rc.2", "@ryanyujazz/dsh-presentation": "^0.1.0",
    "@ryanyujazz/dsh-client-workbench-remotes": "^0.1.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.1", "@deepseek-ai/dsh-client-runtime": "0.1.1-rc.2",
    "@deepseek-ai/dsh-typert-protocol": "0.1.1-rc.2", "@ryanyujazz/dsh-presentation": "workspace:^",
    "@ryanyujazz/dsh-client-workbench-remotes": "workspace:^", "typescript": "^6.0.3", "vitest": "^3.2.4"
  },
  "files": ["lib/index.js", "lib/client.js", "lib/types/**/*.d.ts", "README.md"]
}
