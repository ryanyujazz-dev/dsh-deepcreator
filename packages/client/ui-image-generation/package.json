    "@ryanyujazz/dsh-client-ui-primitives"
  ], "platform": "web" } },
  "scripts": { "bundle": "tsc -p tsconfig.json && tsdown", "typecheck": "tsc -p tsconfig.json --noEmit", "test": "vitest run --root ../../.. packages/client/ui-image-generation/tests" },
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.1", "@deepseek-ai/dsh-api-remotes": "^0.1.1-rc.2", "@deepseek-ai/dsh-attachment": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-client-runtime": "^0.1.1-rc.2", "@deepseek-ai/dsh-client-ui-settings-plugins": "^0.1.1-rc.2", "@deepseek-ai/dsh-client-ui-slots": "^0.1.1-rc.2",
    "@ryanyujazz/dsh-image-generation": "^0.1.0", "@ryanyujazz/dsh-client-locale": "^0.1.0", "@ryanyujazz/dsh-client-ui-conversation": "^0.1.0",
    "@ryanyujazz/dsh-client-ui-settings": "^0.1.0", "@ryanyujazz/dsh-client-ui-tool": "^0.1.0", "@ryanyujazz/dsh-client-ui-primitives": "^0.1.0", "react": "^18.2.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.1", "@deepseek-ai/dsh-api-remotes": "0.1.1-rc.2", "@deepseek-ai/dsh-attachment": "0.1.1-rc.2",
    "@deepseek-ai/dsh-client-runtime": "0.1.1-rc.2", "@deepseek-ai/dsh-client-ui-settings-plugins": "0.1.1-rc.2", "@deepseek-ai/dsh-client-ui-slots": "0.1.1-rc.2",
    "@ryanyujazz/dsh-image-generation": "workspace:^", "@ryanyujazz/dsh-client-locale": "workspace:^", "@ryanyujazz/dsh-client-ui-conversation": "workspace:^",
    "@ryanyujazz/dsh-client-ui-settings": "workspace:^", "@ryanyujazz/dsh-client-ui-tool": "workspace:^", "@ryanyujazz/dsh-client-ui-primitives": "workspace:^",
    "@testing-library/react": "^16.1.0", "@types/react": "~18.3.1", "react": "^18.2.0", "react-dom": "^18.2.0", "typescript": "^6.0.3", "vitest": "^3.2.4"
  },
  "files": ["lib/index.js", "lib/client.js", "lib/types/**/*.d.ts", "README.md"]
