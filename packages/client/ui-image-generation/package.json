{
  "name": "@ryanyujazz/dsh-client-ui-image-generation",
  "description": "Image provider settings, create_image toolview, and standalone generated-image turn media",
  "version": "0.1.0",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-settings-plugins",
        "@ryanyujazz/dsh-client-locale",
        "@ryanyujazz/dsh-client-ui-settings",
        "@ryanyujazz/dsh-client-ui-conversation",
        "@ryanyujazz/dsh-client-ui-tool",
        "@ryanyujazz/dsh-client-ui-primitives"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "bundle": "tsc -p tsconfig.json && tsdown",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --root ../../.. packages/client/ui-image-generation/tests"
  },
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.2",
    "@deepseek-ai/dsh-api-remotes": "^0.1.5-alpha.1",
    "@deepseek-ai/dsh-attachment": "^0.1.5-alpha.1",
    "@deepseek-ai/dsh-client-ui-settings-plugins": "^0.1.5-alpha.1",
    "@deepseek-ai/dsh-client-ui-slots": "^0.1.5-alpha.1",
    "@ryanyujazz/dsh-image-generation": "^0.1.0",
    "@ryanyujazz/dsh-client-locale": "^0.1.0",
    "@ryanyujazz/dsh-client-ui-conversation": "^0.1.0",
    "@ryanyujazz/dsh-client-ui-settings": "^0.1.0",
    "@ryanyujazz/dsh-client-ui-tool": "^0.1.0",
    "@ryanyujazz/dsh-client-ui-primitives": "^0.1.0",
    "react": "^18.2.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.2",
    "@deepseek-ai/dsh-api-remotes": "0.1.5-alpha.1",
    "@deepseek-ai/dsh-attachment": "0.1.5-alpha.1",
    "@deepseek-ai/dsh-client-ui-conversation": "0.1.5-alpha.1",
    "@deepseek-ai/dsh-client-ui-renderer": "0.1.5-alpha.1",
    "@deepseek-ai/dsh-client-ui-settings": "0.1.5-alpha.1",
    "@deepseek-ai/dsh-client-ui-settings-plugins": "0.1.5-alpha.1",
    "@deepseek-ai/dsh-client-ui-slots": "0.1.5-alpha.1",
    "@ryanyujazz/dsh-client-compat": "workspace:*",
    "@ryanyujazz/dsh-client-locale": "workspace:^",
    "@ryanyujazz/dsh-client-ui-conversation": "workspace:^",
    "@ryanyujazz/dsh-client-ui-primitives": "workspace:^",
    "@ryanyujazz/dsh-client-ui-settings": "workspace:^",
    "@ryanyujazz/dsh-client-ui-tool": "workspace:^",
    "@ryanyujazz/dsh-image-generation": "workspace:^",
    "@testing-library/react": "^16.1.0",
    "@types/react": "~18.3.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "typescript": "^6.0.3",
    "vitest": "^3.2.4"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/types/**/*.d.ts",
    "README.md"
  ]
}
