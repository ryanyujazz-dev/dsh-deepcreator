{
  "name": "@ryanyujazz/dsh-client-workbench-remotes",
  "description": "Client BFF mounting the DeepCreator Workbench Host Remote contributions",
  "version": "0.1.0",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "inject": [
        "@deepseek-ai/dsh-api-remotes"
      ],
      "platform": "web",
      "immediately": true
    }
  },
  "scripts": {
    "bundle": "tsc -p tsconfig.json && tsdown",
    "watch": "tsdown --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.1",
    "@deepseek-ai/dsh-api-remotes": "^0.1.0-rc.7",
    "@deepseek-ai/dsh-typert-protocol": "^0.1.0-rc.7",
    "@ryanyujazz/dsh-artifacts": "^0.1.0",
    "@ryanyujazz/dsh-review": "^0.1.0",
    "@ryanyujazz/dsh-session-admin": "^0.1.0",
    "@ryanyujazz/dsh-terminal-workbench": "^0.1.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.1",
    "@deepseek-ai/dsh-api-remotes": "0.1.0-rc.7",
    "@deepseek-ai/dsh-typert-protocol": "0.1.0-rc.7",
    "@ryanyujazz/dsh-artifacts": "workspace:^",
    "@ryanyujazz/dsh-review": "workspace:^",
    "@ryanyujazz/dsh-session-admin": "workspace:^",
    "@ryanyujazz/dsh-terminal-workbench": "workspace:^"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/types/**/*.d.ts"
  ]
}
