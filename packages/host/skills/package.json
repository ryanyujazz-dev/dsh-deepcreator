{
  "name": "@ryanyujazz/dsh-skills",
  "description": "Official deepseek-harness development skills bundled as a DeepCreator host provider",
  "version": "0.1.0",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": { "types": "./lib/types/index.d.ts", "default": "./lib/index.js" },
    "./package.json": "./package.json"
  },
  "scripts": { "bundle": "tsc -p tsconfig.json && tsdown", "typecheck": "tsc -p tsconfig.json --noEmit" },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.1",
    "@deepseek-ai/dsh-skill": "^0.1.0-rc.6"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.1",
    "@deepseek-ai/dsh-skill": "0.1.0-rc.6",
    "@types/node": "^22.20.0"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts",
    "assets/skills/**/*"
  ]
}
