{
  "name": "@ryanyujazz/dsh-browser-playwright",
  "description": "Managed Chromium, Firefox, and WebKit Browser Providers with an isolated Playwright script tool",
  "version": "0.1.0",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": { "types": "./lib/types/index.d.ts", "default": "./lib/index.js" },
    "./package.json": "./package.json"
  },
  "scripts": {
    "bundle": "node scripts/generate-manifest.mjs && tsc -p tsconfig.json && tsdown",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node scripts/generate-manifest.mjs --check && vitest run --root ../../.. packages/host/browser-playwright/tests"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.1",
    "@deepseek-ai/dsh-agent": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-tools": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-subprocess": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-user-approval": "^0.1.1-rc.2",
    "@ryanyujazz/dsh-browser": "^0.1.0"
  },
  "dependencies": {
    "esbuild": "^0.25.12",
    "playwright-core": "1.62.1",
    "quickjs-emscripten": "^0.32.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.1",
    "@deepseek-ai/dsh-agent": "0.1.1-rc.2",
    "@deepseek-ai/dsh-tools": "0.1.1-rc.2",
    "@deepseek-ai/dsh-subprocess": "0.1.1-rc.2",
    "@deepseek-ai/dsh-user-approval": "0.1.1-rc.2",
    "@ryanyujazz/dsh-browser": "workspace:^",
    "@types/node": "^22.20.0",
    "typescript": "^6.0.3",
    "vitest": "^3.2.4"
  },
  "files": ["lib/index.js", "lib/owner-entry.js", "lib/playwright-api-manifest.json", "lib/types/**/*.d.ts", "README.md"],
  "license": "MIT"
}
