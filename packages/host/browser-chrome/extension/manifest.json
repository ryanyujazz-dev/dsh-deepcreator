{
  "manifest_version": 3,
  "name": "DeepCreator Browser Provider",
  "version": "0.1.0",
  "key": "",
  "description": "Share selected Chrome tabs with DeepCreator Browser Runtime.",
  "permissions": ["activeTab", "debugger", "nativeMessaging", "scripting", "storage", "tabs", "tabGroups"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "background": { "service_worker": "service-worker.js", "type": "module" },
  "action": { "default_title": "Share/unshare this tab with DeepCreator" }
}
