{
  "name": "@ryanyujazz/dsh-platform-context",
  "description": "Win32 platform facts (shell dialect, encoding hazards) as a dynamic system-prompt snapshot for DeepCreator",
  "version": "0.1.0",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "bundle": "tsc -p tsconfig.json && tsdown",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.1",
    "@deepseek-ai/dsh-system-prompt": "^0.1.1-rc.2"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.1",
    "@deepseek-ai/dsh-system-prompt": "0.1.1-rc.2",
    "@types/node": "^22.20.0"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ]
}
