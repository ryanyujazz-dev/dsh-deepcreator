{
  "compilerOptions": {
    "target": "es2024", "module": "esnext", "moduleResolution": "bundler",
    "lib": ["ES2024", "DOM"], "types": ["node"], "declaration": true,
    "sourceMap": true, "declarationMap": true, "skipLibCheck": true,
    "strict": true, "noUncheckedIndexedAccess": true, "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true, "noUnusedLocals": true, "noUnusedParameters": true,
    "allowImportingTsExtensions": true, "rewriteRelativeImportExtensions": true,
    "composite": true, "rootDir": "src", "outDir": "lib/types"
  },
  "include": ["src"]
}
