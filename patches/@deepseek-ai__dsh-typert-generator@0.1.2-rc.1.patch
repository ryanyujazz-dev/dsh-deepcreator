+function npmOfficialPackageOf(file) {
+    // Windows realPath() yields backslash separators; normalize before matching
+    // the POSIX-style /node_modules/ marker so platform paths resolve equally.
+    const normalized = file.replaceAll('\\', '/');
+    const marker = '/node_modules/';
+    const at = normalized.lastIndexOf(marker);
+    if (at < 0) return undefined;
+    const rest = normalized.slice(at + marker.length);
+    const match = rest.match(/^(@[^/]+\/[^/]+)\//) ?? rest.match(/^([^@][^/]*)\//);
+    if (match === undefined || match === null || !match[1].startsWith('@deepseek-ai/')) return undefined;
